---
layout: base.njk
---
{# ============================================================
   ARTICLE.NJK
   Layout for one вест / догађај / едукација / конкурс.
   It sets `layout: base.njk` in its own front matter, so
   Eleventy renders this first and then pours the result into
   the shell. That is layout chaining — simpler than blocks.
   ============================================================ #}

<section class="page-hero">
  <div class="container">
    <p class="breadcrumb">
      <a href="/">Почетна</a> &rsaquo;
      <a href="{{ nadredjeniUrl }}">{{ nadredjeni }}</a> &rsaquo; {{ title }}
    </p>

    <p class="eyebrow">
      {%- if type %}{{ type }}
      {%- elif format %}{{ format }}
      {%- elif source %}{{ source }}
      {%- else %}Вест{% endif -%}
    </p>

    <h1 class="page-hero__title">{{ title }}</h1>

    <p class="page-hero__lede">
      {%- if date %}{{ date | datumVremeSrp }}{% endif -%}
      {%- if location %} · {{ location }}{% endif -%}
      {%- if deadline %} · рок: {{ deadline | datumSrp }}{% endif -%}
    </p>
  </div>
</section>

<section class="section">
  <div class="container container--narrow">

    {% if image %}
      <div class="media media--wide" style="margin-bottom: var(--space-xl)">
        <img src="{{ image }}" alt="{{ image_alt or '' }}" width="1200" height="675">
      </div>
    {% endif %}

    {% if summary %}
      <p class="section__lede" style="margin-bottom: var(--space-lg)">{{ summary }}</p>
    {% endif %}

    <div class="prose">
      {{ content | safe }}
    </div>

    {# A PDF shown open on the page. Desktop browsers draw it in the
       <object>; phones (Android Chrome especially) cannot, and show
       the fallback inside it instead — so the fallback is a proper
       card with buttons, not an error message. #}
    {% if pdf %}
      <figure class="pdf-embed">
        <object class="pdf-embed__frame" data="{{ pdf }}#view=FitH" type="application/pdf"
                aria-label="{{ pdf_title or title }}">
          <div class="pdf-embed__fallback">
            <p><strong>{{ pdf_title or title }}</strong></p>
            <p>Ваш уређај не може да прикаже документ унутар стране. Отворите га или преузмите.</p>
            <p><a class="btn" href="{{ pdf }}" target="_blank" rel="noopener">Отворите PDF</a></p>
          </div>
        </object>
        <figcaption class="pdf-embed__bar">
          <span>{{ pdf_title or title }} (PDF)</span>
          <span class="pdf-embed__actions">
            <a class="news__link" href="{{ pdf }}" target="_blank" rel="noopener">Отворите у новом прозору</a>
            <a class="news__link" href="{{ pdf }}" download>Преузмите</a>
          </span>
        </figcaption>
      </figure>
    {% endif %}

    {% if registration_url %}
      <p style="margin-top: var(--space-xl)">
        <a class="btn" href="{{ registration_url }}">Пријавите се</a>
      </p>
    {% endif %}

    {% if external_url %}
      <p style="margin-top: var(--space-xl)">
        <a class="btn" href="{{ external_url }}">Отворите конкурс</a>
      </p>
    {% endif %}

    {% if video_url %}
      <p style="margin-top: var(--space-xl)">
        <a class="btn" href="{{ video_url }}">Погледајте видео</a>
      </p>
    {% endif %}

    {% if file %}
      <p style="margin-top: var(--space-xl)">
        <a class="btn" href="{{ file }}">Преузмите приручник (PDF)</a>
      </p>
    {% endif %}

    <p style="margin-top: var(--space-2xl)">
      <a class="news__link" href="{{ nadredjeniUrl }}">Назад на {{ nadredjeni | lower }}</a>
    </p>

  </div>
</section>
