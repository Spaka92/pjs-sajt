{# ============================================================
   FOOTER — contact details come from src/_data/site.json
   ============================================================ #}
{# ============================================================
   ПАРТНЕРИ
   A moving strip above the dark footer. The list is emitted
   TWICE on purpose: the track slides exactly 50% left, so the
   second copy arrives where the first began and the loop has
   no visible seam.

   It pauses on hover so a visitor can actually read a logo
   they recognise — a marquee you cannot stop is just noise.
   ============================================================ #}
{% if site.partneri and site.partneri.length %}
<section class="partners">
  <div class="container">
    <h2 class="partners__title">{{ site.partneri_naslov or "Наши партнери" }}</h2>
  </div>

  <div class="marquee marquee--partners">
    <ul class="marquee__track">
      {% for pass in [1, 2] %}
        {% for p in site.partneri %}
          <li class="partners__item">
            {% if p.url %}
              <a href="{{ p.url }}" target="_blank" rel="noopener">
                <img src="{{ p.logo }}" alt="{{ p.naziv }}" loading="lazy">
              </a>
            {% else %}
              <img src="{{ p.logo }}" alt="{{ p.naziv }}" loading="lazy">
            {% endif %}
          </li>
        {% endfor %}
      {% endfor %}
    </ul>
  </div>
</section>
{% endif %}

<footer class="site-footer">
  <div class="container site-footer__inner">

    <div>
      <img class="site-footer__logo" src="/images/pjs-logo.png"
           alt="{{ site.skraceno }} — {{ site.naziv }}"
           width="900" height="363" loading="lazy">
      <p class="site-footer__note">
        Удружење грађана<br>{{ site.naziv }}
      </p>
    </div>

    <div>
      <h2 class="site-footer__title">Садржај</h2>
      <ul class="site-footer__list">
        {% for stavka in nav.podnozje_sadrzaj %}
          <li><a href="{{ stavka.url }}">{{ stavka.labela }}</a></li>
        {% endfor %}
      </ul>
    </div>

    <div>
      <h2 class="site-footer__title">Чланство</h2>
      <ul class="site-footer__list">
        {% for stavka in nav.podnozje_clanstvo %}
          <li><a href="{{ stavka.url }}">{{ stavka.labela }}</a></li>
        {% endfor %}
      </ul>
    </div>

    <div>
      <h2 class="site-footer__title">Контакт</h2>
      <p class="site-footer__note">
        {{ site.adresa }}<br>
        {% if site.telefon %}<a href="tel:{{ site.telefon | replace(" ", "") }}">{{ site.telefon }}</a><br>{% endif %}
        <a href="mailto:{{ site.email }}">{{ site.email }}</a><br>
        {{ site.radno_vreme }}
      </p>

      {% if site.facebook or site.instagram or site.youtube %}
        <p class="site-footer__note" style="margin-top: var(--space-sm)">
          {% if site.facebook %}<a href="{{ site.facebook }}">Facebook</a>{% endif %}
          {% if site.instagram %} · <a href="{{ site.instagram }}">Instagram</a>{% endif %}
          {% if site.youtube %} · <a href="{{ site.youtube }}">YouTube</a>{% endif %}
        </p>
      {% endif %}
    </div>

  </div>

  <div class="container site-footer__bar">
    {# `godina` comes from _data/godina.js, evaluated at build
       time. No browser JavaScript involved. #}
    <p>&copy; {{ godina }} {{ site.naziv }}</p>
    <p><a href="/dokumenta/">Статут и документа</a></p>
  </div>
</footer>
