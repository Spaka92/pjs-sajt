{# ============================================================
   FOOTER — contact details come from src/_data/site.json
   ============================================================ #}
<footer class="site-footer">
  <div class="container site-footer__inner">

    <div>
      <p class="site-footer__name">{{ site.skraceno }}</p>
      <p class="site-footer__note">
        Удружење грађана<br>{{ site.naziv }}
      </p>
    </div>

    <div>
      <h2 class="site-footer__title">Садржај</h2>
      <ul class="site-footer__list">
        {% for stavka in nav.podnozje_sadrzaj %}
          <li><a href="{{ stavka.url }}">{{ stavka.labela }}</a></li>
        {% endfor %}
      </ul>
    </div>

    <div>
      <h2 class="site-footer__title">Чланство</h2>
      <ul class="site-footer__list">
        {% for stavka in nav.podnozje_clanstvo %}
          <li><a href="{{ stavka.url }}">{{ stavka.labela }}</a></li>
        {% endfor %}
      </ul>
    </div>

    <div>
      <h2 class="site-footer__title">Контакт</h2>
      <p class="site-footer__note">
        {{ site.adresa }}<br>
        {% if site.telefon %}<a href="tel:{{ site.telefon | replace(" ", "") }}">{{ site.telefon }}</a><br>{% endif %}
        <a href="mailto:{{ site.email }}">{{ site.email }}</a><br>
        {{ site.radno_vreme }}
      </p>

      {% if site.facebook or site.instagram or site.youtube %}
        <p class="site-footer__note" style="margin-top: var(--space-sm)">
          {% if site.facebook %}<a href="{{ site.facebook }}">Facebook</a>{% endif %}
          {% if site.instagram %} · <a href="{{ site.instagram }}">Instagram</a>{% endif %}
          {% if site.youtube %} · <a href="{{ site.youtube }}">YouTube</a>{% endif %}
        </p>
      {% endif %}
    </div>

  </div>

  {# ============================================================
     ЕУ ВИДЉИВОСТ
     The #ЕУ за тебе logo and the funding disclaimer are a grant
     requirement. The logo sits on a white plate because its blue
     lettering would vanish against the dark footer.
     ============================================================ #}
  {% if site.finansiranje %}
  <div class="container site-footer__eu">
    <img class="site-footer__eu-logo" src="{{ site.finansiranje.logo }}"
         alt="{{ site.finansiranje.naziv }}" width="497" height="183" loading="lazy">
    <p class="site-footer__disclaimer">{{ site.finansiranje.tekst }}</p>
  </div>
  {% endif %}

  <div class="container site-footer__bar">
    {# `godina` comes from _data/godina.js, evaluated at build
       time. No browser JavaScript involved. #}
    <p>&copy; {{ godina }} {{ site.naziv }}</p>
    <p><a href="/dokumenta/">Статут и документа</a></p>
  </div>
</footer>
